      "text": "list = useWatchList({ data, brands })        filters = useWatchFilters({ serverFilters })\nwatch = useWatchDrawer({ list })              { setFileInput, ...images } = useWatchImages({ list })\nbrands = useBrands({ filters })               confirm = useDeleteConfirm({ run: { watch: watch.remove,\n                                                                        brand: brands.remove, image: images.remove } })\nThen: rowHandlers for the table, openNewWatch (closes brands drawer, opens drawer with the filtered brand).",
      "originalText": "list = useWatchList({ data, brands })        filters = useWatchFilters({ serverFilters })\nwatch = useWatchDrawer({ list })              { setFileInput, ...images } = useWatchImages({ list })\nbrands = useBrands({ filters })               confirm = useDeleteConfirm({ run: { watch: watch.remove,\n                                                                        brand: brands.remove, image: images.remove } })\nThen: rowHandlers for the table, openNewWatch (closes brands drawer, opens drawer with the filtered brand).",
