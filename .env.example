# Copy to .env and fill in. Never commit .env itself.

# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Prisma Postgres. Locally (and for `prisma migrate`) use the DIRECT host:
DATABASE_URL="postgres://USER:KEY@db.prisma.io:5432/postgres?sslmode=verify-full"
# On Vercel use the POOLED host with the same credentials, or serverless
# instances exhaust the database's connection limit:
#   postgres://USER:KEY@pooled.db.prisma.io:5432/postgres?sslmode=verify-full
# Use sslmode=verify-full, not require: pg warns that require's meaning changes.

# ── Redis (rate limiting) ───────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── App ─────────────────────────────────────────────────────────────────
# Absolute public URL of the site, no trailing slash. Used for links in order
# emails and as the base URL QStash calls (/api/jobs). Optional on Vercel:
# unset, it uses the project's production domain. Never guess it: <name>.vercel.app
# may belong to someone else.
APP_URL="http://localhost:3000"

# Optional: trace | debug | info | warn | error (default: debug in dev, info in prod)
# LOG_LEVEL="info"

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional sender, on a domain verified in Resend. Unset = Resend's sandbox
# sender, which only delivers to your own Resend account email.
# EMAIL_FROM="XII <orders@mail.yourdomain.com>"

# ── Cron ────────────────────────────────────────────────────────────────
# Sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# ── Storage (S3-compatible, e.g. Supabase Storage) ──────────────────────
S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="xii"
S3_ACCESS_KEY_ID="xxxxxxxxxxxxxxxx"
S3_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxx"
# Public base URL for objects: <S3_PUBLIC_URL>/<key>
S3_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/xii"

# ── Background jobs (Upstash QStash) ────────────────────────────────────
# Production: copy all four from the Upstash console (QStash). QSTASH_URL is
# your region's endpoint, e.g. https://qstash-eu-central-1.upstash.io; never
# deploy the local dev-server URL (127.0.0.1).
# Local: run `npx @upstash/qstash-cli dev` and use the token, signing keys and
# URL it prints. Without a token, jobs run inline with no retries.
QSTASH_TOKEN="xxxxxxxxxxxxxxxx"
QSTASH_CURRENT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxx"
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
