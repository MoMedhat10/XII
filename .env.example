# Copy to .env and fill in. Never commit .env itself.

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/xii?schema=public"

# ── Redis (rate limiting) ───────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── App ─────────────────────────────────────────────────────────────────
# Absolute public URL of the site, no trailing slash. Used for links in order
# emails and as the base URL QStash calls (/api/jobs).
APP_URL="http://localhost:3000"

# Optional: trace | debug | info | warn | error (default: debug in dev, info in prod)
# LOG_LEVEL="info"

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional sender, on a domain verified in Resend. Unset = Resend's sandbox
# sender, which only delivers to your own Resend account email.
# EMAIL_FROM="XII <orders@mail.yourdomain.com>"

# ── Cron ────────────────────────────────────────────────────────────────
# Sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# ── Storage (S3-compatible, e.g. Supabase Storage) ──────────────────────
S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="xii"
S3_ACCESS_KEY_ID="xxxxxxxxxxxxxxxx"
S3_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxx"
# Public base URL for objects: <S3_PUBLIC_URL>/<key>
S3_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/xii"

# ── Background jobs (Upstash QStash) ────────────────────────────────────
# Production: copy these from the Upstash console and never set QSTASH_URL
# (it points publishes at the local dev server).
# Local: run `npx @upstash/qstash-cli dev` and use the token, signing keys and
# URL it prints. Without a token, jobs run inline with no retries.
QSTASH_TOKEN="xxxxxxxxxxxxxxxx"
QSTASH_CURRENT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxx"
# QSTASH_URL="http://127.0.0.1:8080"
