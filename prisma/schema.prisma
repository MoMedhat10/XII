// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum WatchGender {
  MEN
  WOMEN
  UNISEX
}

enum MovementType {
  AUTOMATIC
  MANUAL
  QUARTZ
  SOLAR
  SMART
}

enum WatchCondition {
  NEW
  PRE_OWNED
  REFURBISHED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.Citext
  email        String   @unique @db.Citext
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerifiedAt       DateTime?
  cart                  Cart?
  session               Session[]
  passwordResetSessions PasswordResetSession[]
  orders                Order[]
  favorites             FavoriteWatch[]
  verificationCodes     VerificationCode[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetSession {
  id         String    @id
  userId     String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationCode {
  id        String               @id @default(uuid())
  userId    String
  codeHash  String
  type      VerificationCodeType
  expiresAt DateTime
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique @db.Citext
  description String
  logoKey     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watches Watch[]
}

model Watch {
  id           String          @id @default(uuid())
  name         String
  description  String
  model        String
  priceCents   Int
  stock        Int
  brandId      String
  gender       WatchGender?
  movement     MovementType?
  caliber      String?
  caseMaterial String?
  condition    WatchCondition?
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  brand      Brand           @relation(fields: [brandId], references: [id])
  images     WatchImage[]
  favorites  FavoriteWatch[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([brandId])
  @@index([isActive, createdAt])
  @@index([isActive, priceCents])
}

model WatchImage {
  id          String   @id @default(uuid())
  watchId     String
  key         String   @unique // "watches/<watchId>/<uuid>.webp", not a URL
  alt         String   @default("")
  width       Int?
  height      Int?
  sizeBytes   Int
  contentType String
  sortOrder   Int
  createdAt   DateTime @default(now())

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, sortOrder])
}

model FavoriteWatch {
  id        String   @id @default(uuid())
  userId    String
  watchId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([userId, watchId])
  @@index([watchId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  watchId   String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([cartId, watchId])
  @@index([watchId])
}

model Order {
  id            String      @id @default(uuid())
  userId        String?
  customerEmail String      @db.Citext
  status        OrderStatus @default(PAID)
  totalCents    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  watchId        String
  quantity       Int
  unitPriceCents Int
  // Snapshot taken at checkout, so the order keeps what was bought even
  // after the watch is renamed, re-branded or its images change.
  watchName      String
  watchModel     String
  brandName      String
  imageKey       String? // "orders/<uuid>.<ext>": a copy, never the watch's own image
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: a watch that was ordered can't be deleted (unpublish it instead)
  watch Watch @relation(fields: [watchId], references: [id])

  @@index([orderId])
  @@index([watchId])
}
