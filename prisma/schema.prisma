// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart      Cart?
  session    Session[]
  orders    Order[]
  favorites FavoriteWatch[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String   
  expiresAt DateTime
  createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  logoUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watches Watch[]
}

model Watch {
  id          String   @id @default(uuid())
  name        String
  description String
  model       String
  price       Decimal
  stock       Int
  brandId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand           @relation(fields: [brandId], references: [id])
  images     WatchImage[]
  favorites  FavoriteWatch[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model WatchImage {
  id        String   @id @default(uuid())
  watchId   String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  watch Watch @relation(fields: [watchId], references: [id])

  @@unique([watchId, sortOrder])
}

model FavoriteWatch {
  id        String   @id @default(uuid())
  userId    String
  watchId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  watch Watch @relation(fields: [watchId], references: [id])

  @@unique([userId, watchId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  watchId   String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart  Cart  @relation(fields: [cartId], references: [id])
  watch Watch @relation(fields: [watchId], references: [id])

  @@unique([cartId, watchId])
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  status     OrderStatus @default(PAID)
  total      Decimal
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  watchId   String
  quantity  Int
  unitPrice Decimal
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  watch Watch @relation(fields: [watchId], references: [id])
}